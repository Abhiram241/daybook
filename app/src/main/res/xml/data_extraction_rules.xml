<?xml version="1.0" encoding="utf-8"?>
<!--
  Health log (meals, medication times, free-text notes) lives in the Room database under
  databases/. An explicit <include domain="sharedpref"> means ONLY shared preferences are
  eligible for cloud backup and device-to-device transfer — the database is excluded by
  omission. The app ships an explicit export/import flow for moving data deliberately.
-->
<data-extraction-rules>
  <cloud-backup>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="device_id.xml" />
  </cloud-backup>
  <device-transfer>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="device_id.xml" />
  </device-transfer>
</data-extraction-rules>
